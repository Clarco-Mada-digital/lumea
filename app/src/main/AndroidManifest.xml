<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Réseau : utilisé uniquement par l'écran « Assistant IA », qui ouvre la page
        publique d'un service de chat extérieur. Aucune donnée de l'application n'y
        transite : ni le journal, ni le cycle, ni la grossesse. Tout le reste de
        Lumea, y compris le conseiller du cycle, fonctionne hors ligne.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Micro : uniquement pour le journal vocal, enregistré sur le téléphone et
        jamais transmis. Écrire suppose de savoir écrire, d'avoir le temps et la
        force — trois conditions qui ne sont pas toujours réunies.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".LumeaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumea">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Lumea.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notif.ReminderReceiver"
            android:exported="false" />

        <!--
            Widget d'écran d'accueil. Il ne se met pas à jour tout seul
            (updatePeriodMillis=0) : c'est l'app qui le rafraîchit quand les
            données changent, ce qui évite de réveiller le téléphone pour rien.
        -->
        <receiver
            android:name=".widget.LumeaWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lumea_widget_info" />
        </receiver>

        <receiver
            android:name=".notif.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
