<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde automatique : les données de santé restent sur l'appareil.
     La sauvegarde se fait manuellement depuis Réglages > Sauvegarde. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
