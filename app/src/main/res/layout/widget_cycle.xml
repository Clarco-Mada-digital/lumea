<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget d'écran d'accueil : un grand chiffre, un mot, rien d'autre.

    Il tient en deux lignes pour rester lisible sur la plus petite taille
    possible, et n'emploie aucun mot qui révélerait une grossesse à un tiers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFF4F7"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#B3FFF4F7"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:paddingTop="4dp"
        android:textColor="#99FFF4F7"
        android:textSize="10sp" />
</LinearLayout>
